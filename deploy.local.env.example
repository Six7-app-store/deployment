# ======================================================================
# Zugangsdaten für den lokalen Deploy (deploy.cmd)
# ----------------------------------------------------------------------
# Kopieren nach  deploy.local.env  und ausfüllen.
#
#     copy deploy.local.env.example deploy.local.env
#
# deploy.local.env steht in .gitignore und wird nicht committet. Trotzdem:
# Diese Datei enthält Produktionszugänge. Nicht per Chat, Mail oder Ticket
# weitergeben.
#
# Format: KEY=WERT, keine Anführungszeichen, keine Leerzeichen um das =.
# ======================================================================


# ----------------------------------------------------------------------
# OpenStack — aus der clouds.yaml im DHBW-Self-Service
# ----------------------------------------------------------------------
OS_AUTH_URL=https://newstack.dhbw.cloud:5000
OS_REGION_NAME=DHBW-MA
OS_APPLICATION_CREDENTIAL_ID=
OS_APPLICATION_CREDENTIAL_SECRET=


# ----------------------------------------------------------------------
# Terraform-State — PFLICHT
# ----------------------------------------------------------------------
# Verbindung zur Postgres-Datenbank, in der der Terraform-State liegt
# (Schema "staging", siehe infrastructure/terraform/envs/staging/backend.tf).
#
# Ohne diesen Wert kennt Terraform den bestehenden Zustand nicht. Es würde
# die laufende VM nicht erkennen und eine ZWEITE anlegen — deshalb bricht
# das Skript ab, statt zu raten.
#
# Format: postgres://BENUTZER:PASSWORT@HOST:5432/DATENBANK?sslmode=require
PG_CONN_STR=


# ----------------------------------------------------------------------
# SSH-Schlüssel für die VM
# ----------------------------------------------------------------------
# Pfad zum PRIVATEN Schlüssel, mit dem Ansible sich auf die VM verbindet.
# Der öffentliche Teil wird daraus abgeleitet — es reicht der private.
#
# Der Schlüssel darf KEINE Passphrase haben, sonst bliebe der Deploy an
# der Eingabeaufforderung hängen.
#
# Windows-Pfad mit normalen Backslashes, ohne Anführungszeichen:
SSH_KEY_PATH=C:\Users\luish\.ssh\openstack-key


# ----------------------------------------------------------------------
# .env des Stacks
# ----------------------------------------------------------------------
# Pfad zu der Datei, die Ansible wörtlich als .env auf die VM schreibt.
# Enthält Datenbank-, Keycloak- und RabbitMQ-Zugänge.
ENV_FILE_PATH=C:\Users\luish\staging.env


# ----------------------------------------------------------------------
# Hostname (optional)
# ----------------------------------------------------------------------
# Wird nur für die Abnahme am Ende gebraucht: das Skript ruft danach
# https://<HOST>/ und /api/health auf und meldet den Status.
#
# Erreichbar ist der Store nur über IPv6 — ohne IPv6 im Tunnel meldet die
# Abnahme 000, obwohl der Stack läuft.
APP_HOSTNAME=appstore.s241699-at-student-dhbw-mannheim-de.users.dhbw.site
