# Generated per-deploy by the CI workflow from `terraform output -raw vm_ip`.
# Contains a live server IP; never commit it.
inventory.ini

# Same, for the Forgejo host — written by inventory-forgejo.sh. That one has no
# workflow to clean it up afterwards, so it stays on disk between runs and this
# entry is what keeps it out of a commit.
inventory.forgejo.ini

# External Galaxy roles are fetched at deploy time from requirements.yml,
# not vendored. Don't commit whatever ansible-galaxy installs here.
roles_external/

