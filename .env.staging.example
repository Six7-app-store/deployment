# ================================================================
# Staging — Vorlage für das STAGING_ENV_FILE-Secret.
#
# Diese Datei wird von keinem Befehl gelesen. `make env` kopiert
# .env.example (Dev), nicht diese hier. Ausfüllen, den Inhalt als
# Secret STAGING_ENV_FILE hinterlegen — Ansible schreibt ihn beim
# Deploy wörtlich als .env auf die VM.
#
# Alles ohne Default ist Pflicht: docker-compose.staging.yml
# schreibt diese Felder als ${VAR:?...}, der Stack startet also
# gar nicht erst, wenn eines fehlt oder leer ist. Das ist Absicht —
# lieber ein Abbruch beim Start als ein halb konfigurierter Stack,
# dessen Fehler man später mühsam zurückverfolgt.
#
# KEIN Schlüssel darf doppelt vorkommen. Compose nimmt bei einem
# Duplikat den LETZTEN Eintrag, das Playbook liest APP_BASE_URL
# aber mit `grep | head -n1`, also den ERSTEN. Ein doppelter
# Schlüssel wählt damit nicht einfach einen Wert aus, sondern gibt
# den Containern und dem Keycloak-Realm zwei verschiedene — und der
# Stack startet dabei ohne Fehlermeldung.
# ================================================================

# ----------------------------------------------------------------
# URLs
# ----------------------------------------------------------------
# APP_HOSTNAME muss ein DNS-Name sein, dessen Record auf die VM
# zeigt. ACME stellt Zertifikate für Domains aus, nie für nackte
# Adressen — einen Platzhalter wie <VM-IP> gibt es hier nicht mehr.
# ---- URLs / Hostname ----
APP_HOSTNAME=
# --- App base URL (used by Ansible to template Keycloak realm redirect URIs) ---
APP_BASE_URL=

# ----------------------------------------------------------------
# VITE
# ----------------------------------------------------------------
VITE_APP_URL=https://
VITE_API_URL=https://
VITE_KEYCLOAK_URL=https://

# CORS_ORIGINS ist im Backend als list[str] deklariert und wird
# deshalb als JSON geparst. Eine nackte URL ist kein gültiges JSON
# und lässt das Backend mit SettingsError abbrechen — die eckigen
# Klammern und Anführungszeichen sind Pflicht, auch bei nur einem
# Eintrag.
CORS_ORIGINS=["https://"]

# ----------------------------------------------------------------
# TLS / ACME
# ----------------------------------------------------------------
# Caddy holt das Zertifikat über dns-01, weil die CA diesen Host
# nicht erreichen kann: wenn der Endpunkt keinen AAAA-Record hat, und
# die VM hängt nur an IPv6. Statt eingehender Verbindung schreibt
# Caddy selbst einen TXT-Record per RFC 2136.
#
# Name und Schlüssel der Zone stehen im DHBW-Self-Service unter
# "TLS Certificates". ACME_CA_URL, DNS_SERVER und DNS_TSIG_KEY_ALG
# haben passende Defaults und können leer bleiben.
ACME_EMAIL=
DNS_TSIG_KEY_NAME=
DNS_TSIG_KEY=

# ----------------------------------------------------------------
# Backend
# ----------------------------------------------------------------
# SECRET_KEY erzeugen mit: make secret
SECRET_KEY=
# CREDENTIAL_ENCRYPTION_KEY ist ein Fernet-Key, den Backend und
# Worker gemeinsam nutzen: das Backend verschlüsselt damit die
# OpenStack-Credentials, der Worker entschlüsselt sie. Wird er nur
# in einem der beiden gedreht, schlägt jedes Deployment fehl.
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CREDENTIAL_ENCRYPTION_KEY=
#
# --- Backend Postgres ---
DB_USER=postgres
DB_PASSWORD=changethis
DB_NAME=appstore

# ----------------------------------------------------------------
# Keycloak
# ----------------------------------------------------------------
# KEYCLOAK_CLIENT_SECRET steht nicht im Realm-Export, der zeigt nur
# Sterne. Nach dem ersten Deploy im Keycloak-Admin neu erzeugen
# (Clients → appstore-backend → Credentials → Regenerate) und ins
# Secret STAGING_ENV_FILE eintragen — nicht in die .env auf der VM,
# die wird bei jedem Deploy aus dem Secret überschrieben.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_DB_NAME=keycloak

# ----------------------------------------------------------------
# RabbitMQ
# ----------------------------------------------------------------
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=changethis

# ----------------------------------------------------------------
# Terraform-State-DB (nur der Worker greift darauf zu)
# ----------------------------------------------------------------
TFSTATE_DB_USER=terraform
TFSTATE_DB_PASSWORD=changethis
TFSTATE_DB_NAME=tfstate

# ----------------------------------------------------------------
# Git-Zugriff auf App-Repositories
# ----------------------------------------------------------------
# GitHub App dieser Installation; Backend und Worker lesen damit.
# Schlüssel einzeilig: base64 < app.private-key.pem | tr -d '\n'
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Optional: nur noch für GitLab-Repos und als Rückfall ohne App.
GIT_ACCESS_TOKEN=

# ----------------------------------------------------------------
# SMTP
# ----------------------------------------------------------------
# Aus: SMTP_ENABLED=false, Rest leer. Für Gmail ein App-Password
# verwenden, nicht das Account-Passwort.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=DHBW-AppStore

# ----------------------------------------------------------------
# Images
# ----------------------------------------------------------------
# GHCR-Namespace, aus dem backend, worker und frontend gezogen
# werden. Ohne Eintrag greift der Default aus
# docker-compose.staging.yml: dhbw-appstore, also das Upstream-
# Projekt. Wer in einem Fork arbeitet, trägt hier dessen
# Organisation ein (kleingeschrieben — GHCR-Pfade sind es immer),
# sonst zieht der Deploy die Images des Upstreams statt der eigenen.
#
# Liegen die Packages privat, braucht der Pull zusätzlich einen
# Login; den macht Ansible mit GIT_ACCESS_TOKEN und GIT_USER
# aus dieser Datei.
IMAGE_NAMESPACE=

# Default ist überall "latest". Auf einen konkreten Tag setzen,
# wenn ein Deploy reproduzierbar sein soll.
BACKEND_VERSION=latest
WORKER_VERSION=latest
FRONTEND_VERSION=latest
