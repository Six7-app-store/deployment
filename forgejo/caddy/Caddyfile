# Reverse proxy and TLS termination for the Forgejo host.
#
# Simpler than the staging Caddyfile: there is one upstream, not four, and no
# path routing — Forgejo serves its API, web UI and git-over-HTTP from the same
# root, so anything clever here would only get in the way.
#
# FORGEJO_HOSTNAME must be a DNS name that resolves to this VM. ACME issues
# certificates for domains, never for bare IP addresses. It must also match
# FORGEJO_ROOT_URL in the .env — that value is what Forgejo puts in clone URLs
# and webhooks, and a mismatch produces links that do not resolve.
{
	acme_ca {$ACME_CA_URL}
	email {$ACME_EMAIL}
}

{$FORGEJO_HOSTNAME} {
	# dns-01 is not a preference here but the only option: the security group
	# in envs/forgejo restricts 80 and 443 to the campus range, so the CA can
	# open neither an http-01 nor a tls-alpn-01 connection. Caddy writes the
	# TXT record itself over RFC 2136, so nothing has to reach us.
	#
	# Needs the rfc2136 module, which is why this image is built rather than
	# pulled - see Dockerfile.
	tls {
		dns rfc2136 {
			key_name {$DNS_TSIG_KEY_NAME}
			key_alg {$DNS_TSIG_KEY_ALG}
			key {$DNS_TSIG_KEY}
			server {$DNS_SERVER}
		}
	}

	reverse_proxy forgejo:3000

	# Forgejo's own default is 0 (unlimited) and it enforces its own limits per
	# upload type. This cap exists for what the proxy sees: a git push of a
	# large repository arrives as one request body, and 512 MB is well above
	# anything this instance is meant to hold while still bounding the damage
	# a runaway client can do.
	request_body {
		max_size 512MB
	}
}

# ----------------------------------------------------------------------
# Der Deploy-Anstoss von aussen
# ----------------------------------------------------------------------
# 443 oben bleibt campus-only, per Security Group. Dieser Port ist der eine
# Spalt nach draussen, damit ein GitHub-Runner nach einem Merge den
# Staging-Deploy ausloesen kann - siehe docs/deployment-process.md, Abschnitt 11.
#
# Er ist bewusst eng: erlaubt sind drei Endpunkte an genau einem Repository,
# alles andere bekommt 404 - auch die Anmeldeseite, auch git-over-HTTPS. Wer den
# Port scannt, sieht eine Caddy-Instanz, die nichts preisgibt.
#
# Zwei Huerden, nicht eine. Der Header ist ein gemeinsames Geheimnis und wird
# hier nur zeichenweise verglichen; er haelt Scanner fern, ist aber keine
# Authentifizierung. Die macht Forgejo selbst ueber den Token im
# Authorization-Header, der weiter hinten geprueft wird.
{$FORGEJO_HOSTNAME}:{$DISPATCH_PORT} {
	tls {
		dns rfc2136 {
			key_name {$DNS_TSIG_KEY_NAME}
			key_alg {$DNS_TSIG_KEY_ALG}
			key {$DNS_TSIG_KEY}
			server {$DNS_SERVER}
		}
	}

	# Den Deploy starten.
	@dispatch {
		method POST
		path /api/v1/repos/{$FORGEJO_DEPLOY_REPO}/actions/workflows/*/dispatches
		header X-Deploy-Auth {$FORGEJO_DISPATCH_AUTH}
	}

	# Den Pull-Mirror sofort nachziehen. Ohne diesen Aufruf laeuft der Deploy
	# unter Umstaenden noch mit dem Stand von vor dem Merge: Forgejo holt sich
	# den Mirror in seinem eigenen Takt, nicht beim Push.
	@sync {
		method POST
		path /api/v1/repos/{$FORGEJO_DEPLOY_REPO}/mirror-sync
		header X-Deploy-Auth {$FORGEJO_DISPATCH_AUTH}
	}

	# Nachsehen, welchen Commit der Mirror inzwischen hat. Der Ausloeser wartet
	# damit, bis der eigene Commit angekommen ist, bevor er den Deploy startet.
	@branch {
		method GET
		path /api/v1/repos/{$FORGEJO_DEPLOY_REPO}/branches/*
		header X-Deploy-Auth {$FORGEJO_DISPATCH_AUTH}
	}

	reverse_proxy @dispatch forgejo:3000
	reverse_proxy @sync forgejo:3000
	reverse_proxy @branch forgejo:3000

	# Alles andere. 404 statt 403, damit die Antwort nicht verraet, dass es hier
	# ueberhaupt etwas zu treffen gibt.
	respond 404
}
