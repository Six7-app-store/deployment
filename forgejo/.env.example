# Copy to .env and fill in. This file configures the Forgejo instance itself —
# the *deploy* secrets (OS_*, SSH_PRIVATE_KEY, STAGING_ENV_FILE) do NOT go here.
# Those live in Forgejo's repo secrets, which is the whole point of the exercise.

# Any strong value; only used between the db and forgejo containers.
FORGEJO_DB_PASSWORD=

# Must resolve identically from your browser and from inside job containers.
# The /etc/hosts entry in README.md is what makes `forgejo` work in both.
FORGEJO_DOMAIN=forgejo
FORGEJO_ROOT_URL=http://forgejo:3000/

# Site admin -> Actions -> Runners -> "Create new runner" in the Forgejo UI.
# Only needed on first start; after registration it is ignored.
FORGEJO_RUNNER_TOKEN=

# ---------------------------------------------------------------------------
# VM only - the caddy service, started with `--profile tls`.
# Leave the block empty in Phase 1; nothing reads it.
# ---------------------------------------------------------------------------

# Must be the host part of FORGEJO_ROOT_URL above, and must resolve to this VM.
# ACME issues certificates for domains, never for bare IP addresses.
FORGEJO_HOSTNAME=

# Contact address for the ACME account, not a login.
ACME_EMAIL=

# Defaults cover the DHBW zone; override only for a different CA or nameserver.
# ACME_CA_URL=https://certificates.dhbw.cloud/directory
# DNS_SERVER=ns.cloud-ns.dhbw-mannheim.de.:53
# DNS_TSIG_KEY_ALG=hmac-sha512

# TSIG credentials for the dns-01 challenge, from the zone's TLS certificates
# page in the self-service UI. dns-01 is not optional on this host: 80 and 443
# are campus-restricted, so the CA can reach neither.
DNS_TSIG_KEY_NAME=
DNS_TSIG_KEY=
