# OpenStack Staging Secrets
STAGING_OS_AUTH_URL= 
STAGING_OS_APPLICATION_CREDENTIAL_ID=
STAGING_OS_APPLICATION_CREDENTIAL_SECRET=
STAGING_OS_REGION_NAME=

# OpenStack Production Secrets
PRODUCTION_OS_AUTH_URL= 
PRODUCTION_OS_APPLICATION_CREDENTIAL_ID=
PRODUCTION_OS_APPLICATION_CREDENTIAL_SECRET=
PRODUCTION_OS_REGION_NAME=

# Shared Secrets
SSH_PRIVATE_KEY=

# The staging stack's entire .env, stored as one secret rather than as one
# secret per field. Ansible writes it verbatim to the VM, so its contents are
# the runtime configuration, not the CI configuration - the fields are listed
# in infrastructure/README.md. Every one of them marked required there aborts
# `compose up` when missing, which is deliberate: the stack refuses to start
# half-configured instead of failing later in a way that is harder to trace.
STAGING_ENV_FILE=
