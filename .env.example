# ================================================================
# Lokales Dev-Setup — kopiere zu .env und trage die Werte ein.
#
# Nur die Felder hier sind nötig, damit der Dev-Stack
# (`make dev-up`) startet. Alle weiteren Compose-Variablen haben
# in docker-compose.dev.yml sinnvolle Defaults für Dev.
#
# Staging/Production-Variablen leben NICHT in dieser Datei —
# siehe infrastructure/README.md für die Liste der Felder, die
# ins STAGING_ENV_FILE-Secret gehören.
# ================================================================

# ----------------------------------------------------------------
# Pflicht: Symmetrischer Fernet-Key (Backend ↔ Worker)
# ----------------------------------------------------------------
# Backend verschlüsselt OpenStack-Credentials at rest mit diesem
# Schlüssel; Worker entschlüsselt den Envelope den er via Celery
# bekommt. Beide Services MÜSSEN denselben Wert nutzen — sonst
# crasht der Stack beim Start.
#
# Generieren mit:
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CREDENTIAL_ENCRYPTION_KEY=

# ----------------------------------------------------------------
# Pflicht für Login: Keycloak-Client-Secret
# ----------------------------------------------------------------
# Erst nach dem ersten Keycloak-Boot aus dem Admin-UI holen
# (Schritt 6 in docs/setup.md). Bis dahin Platzhalter eintragen.
KEYCLOAK_CLIENT_SECRET=

# ----------------------------------------------------------------
# Empfohlen: GitHub Personal Access Token (repo-Scope)
# ----------------------------------------------------------------
# Wird gebraucht, damit der Backend gegen private App-Repos
# verifizieren und der Worker beim Deployment klonen kann.
# Für reines UI-Testen ohne private Repos darf der Wert leer
# bleiben.
GIT_ACCESS_TOKEN=

# ----------------------------------------------------------------
# Optional: SMTP für E-Mail-Benachrichtigungen
# ----------------------------------------------------------------
# Aus: SMTP_ENABLED=false und alles andere leer lassen.
# An: SMTP_ENABLED=true und die Werte unten füllen.
# Für Gmail ein App-Password verwenden, nicht das Account-Passwort:
#   https://support.google.com/accounts/answer/185833
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Click-n-Deploy

# ----------------------------------------------------------------
# Optional: Moodle-Anbindung über LTI 1.3
# ----------------------------------------------------------------
# Aus: LTI_ENABLED=false — die /lti-Endpunkte antworten dann mit 503,
# sonst ändert sich nichts. An: LTI_ENABLED=true und die Werte unten
# füllen. Die fünf Plattformwerte liefert Moodle beim Registrieren des
# Tools (Website-Administration -> Plugins -> Externes Tool ->
# Toolkonfigurationsdetails ansehen).
# Anleitung: docs/moodle-lti-dev.md
LTI_ENABLED=false
LTI_PLATFORM_ISSUER=http://host.docker.internal:8081
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_JWKS_URL=http://host.docker.internal:8081/mod/lti/certs.php
LTI_AUTH_LOGIN_URL=http://host.docker.internal:8081/mod/lti/auth.php
LTI_TOKEN_URL=http://host.docker.internal:8081/mod/lti/token.php

# Eigenes RSA-Schlüsselpaar des Tools, PEM als base64 (einzeilig). Der
# öffentliche Teil wird beim Start daraus abgeleitet und unter
# /lti/jwks veröffentlicht — er gehört nicht in die .env. Die kid im
# JWKS berechnet PyLTI1p3 selbst aus dem Schlüssel; sie ist nicht
# konfigurierbar.
# Erzeugen:
#   python -c "import base64;from cryptography.hazmat.primitives import serialization as s;from cryptography.hazmat.primitives.asymmetric import rsa;k=rsa.generate_private_key(public_exponent=65537,key_size=2048);print(base64.b64encode(k.private_bytes(s.Encoding.PEM,s.PrivateFormat.PKCS8,s.NoEncryption())).decode())"
LTI_PRIVATE_KEY_B64=

# Schlüssel für das Sitzungstoken, das der App Store nach einem Launch
# selbst ausstellt. Beliebiger langer Zufallswert:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
LTI_SESSION_SECRET=
LTI_SESSION_TTL_MINUTES=120
# A launch whose Moodle identity is unknown but whose e-mail address is
# already taken is refused and handed a link challenge. It is spent at
# POST /lti/link after a direct sign-in, so this only has to outlast one
# login round trip.
LTI_LINK_CHALLENGE_TTL_MINUTES=10
LTI_LAUNCH_REDIRECT_URL=http://host.docker.internal:5173/lti/callback
# Where a refused launch lands: the Moodle identity is unknown and the
# address already belongs to an account, so it has to be confirmed by a
# direct sign-in before the two are linked.
# Bewusst localhost und nicht host.docker.internal: diese Seite verlangt
# eine direkte Keycloak-Anmeldung, und deren PKCE braucht crypto.subtle.
# Das gibt der Browser nur in einem secure context her — http zählt nur
# fuer localhost als sicher. Ueber host.docker.internal scheitert der
# Login mit "Crypto.subtle is available only in secure contexts".
# Der Launch selbst bleibt auf host.docker.internal, nur dieser eine
# Umweg nicht. In Produktion (HTTPS) faellt die Unterscheidung weg.
LTI_LINK_REDIRECT_URL=http://localhost:5173/lti/link

# Ob eine Trainer-Rolle im Moodle-Kurs die globale Dozentenrolle im App
# Store vergibt. Aus, weil diese Rolle fremde OpenStack-Ressourcen
# steuert — die Freigabe bleibt eine bewusste Admin-Entscheidung.
LTI_TRUST_INSTRUCTOR_ROLE=false

# ----------------------------------------------------------------
# Optional: lokale Moodle-Testinstanz (LTI 1.3)
# ----------------------------------------------------------------
# Nur nötig, wenn die Defaults von docker-compose.moodle.yml nicht
# passen (z. B. Port 8081 belegt). MOODLE_PORT und MOODLE_SITE_URL
# müssen zusammenpassen — MOODLE_SITE_URL wird zu Moodles wwwroot und
# damit zum LTI-Issuer.
# Anleitung: docs/moodle-lti-dev.md
#MOODLE_PORT=8081
#MOODLE_SITE_URL=http://host.docker.internal:8081
#MOODLE_ADMIN_USER=admin
#MOODLE_ADMIN_PASSWORD=Moodle#2026
#MOODLE_ADMIN_EMAIL=admin@example.com
#MOODLE_SITE_NAME=DHBW-Fake-Moodle
